# Copy to .env and edit. Never commit .env (it is gitignored).
#
# Read by: `make run`, `make bootstrap`, `make bootstrap-apply`, and
# docker-compose (via env_file). NOT read by the app -- app/.env is separate and
# needs EXPO_PUBLIC_API_URL (a hostname your phone can reach) and
# EXPO_PUBLIC_API_TOKEN (the same value as BOXWRIGHT_API_TOKEN below).

# Backend
PORT=8080
# Bind address. Defaults to loopback: this service holds a Homebox API key and
# can write to your inventory, so exposing it should be deliberate.
#
# Loopback is unusable for two common cases: a phone cannot reach it, and
# inside a container it binds the CONTAINER's loopback, so a published port
# refuses connections and `docker compose up` appears broken. Both need
# 0.0.0.0 -- which then REQUIRES the token below, or the server refuses to
# start.
LISTEN_ADDR=127.0.0.1
# Shared secret required on /api requests. Generate: openssl rand -base64 32
BOXWRIGHT_API_TOKEN=
HOMEBOX_BASE_URL=http://homebox:7745/api
HOMEBOX_API_KEY=

# Accept a Homebox URL and token per request (X-Boxwright-Homebox-Url and
# X-Boxwright-Homebox-Token), so one backend can serve people who each have
# their own Homebox -- what a signed app build needs, since its users' items
# must not land in yours.
#
# Leave this false for a single-user deployment. With it true, an authenticated
# caller decides which host this server connects to, so BOXWRIGHT_API_TOKEN
# becomes the boundary of that as well as an access control; the server refuses
# to start with it on, a non-loopback bind, and no token.
ALLOW_CLIENT_HOMEBOX=false

# Homebox server (docker-compose): 32+ chars, treat as a secret
HBOX_AUTH_API_KEY_PEPPER=dev-only-pepper-change-me-32chars!

# AI layer: openai | ollama | anthropic | claude-code | none
# Identification is an enhancement, never a requirement: with none, the app
# still works through manual entry and the placement engine is unaffected.
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Anthropic only. AI_EFFORT is low|medium|high|xhigh|max (empty: the model's
# default). AI_THINKING is auto (the least thinking the model allows) or
# adaptive (the model decides). `make identeval` measures which is worth it.
AI_EFFORT=
AI_THINKING=

# Examples:
#   OpenAI-compatible cloud:  AI_PROVIDER=openai AI_BASE_URL=https://api.openai.com/v1 AI_MODEL=gpt-5-mini
#   Local Ollama:             AI_PROVIDER=ollama AI_BASE_URL=http://ollama:11434 AI_MODEL=gemma3:4b
#   Anthropic:                AI_PROVIDER=anthropic AI_API_KEY=sk-ant-...
#
# Anthropic notes: AI_BASE_URL and AI_MODEL both default (https://api.anthropic.com
# and claude-sonnet-5-5, chosen by `make identeval`; see docs/IDENTIFICATION.md),
# so the key is the only required setting. Point AI_BASE_URL
# at a gateway to route through it instead; the key may then be omitted if the
# gateway authenticates for you.
# MEASURED 2026-09-30, Sonnet 5.5 over 20 photos: $0.016 a photo on average,
# 2.3 s at the median for one item and ~13 s for a crowded shelf. About 58% of
# the bill is the ~4,700-token prompt, the rest scales with how many THINGS are
# in the photo. Every call logs inputTokens, outputTokens and estimatedUSD, so
# read the log rather than trusting this comment.
#
# Per-item crops need a model that can locate objects. Sonnet 5 can; Haiku 4.5
# and gemma3:4b cannot, and their boxes are detected and discarded. That
# affects crops only -- identification is fine on all three.
#
# Cost per million tokens (input/output):
#   claude-sonnet-5-5 $2 / $10  the default: found every labelled item in the eval
#   claude-opus-5-5   $4 / $20  no better here, and sometimes answers "placeholder"
#   claude-haiku-4-5  $1 / $5   cheapest; misses things in crowded photos
# Use the plain model id -- do not append a date suffix.

# ---------------------------------------------------------------------------
# AI_PROVIDER=claude-code -- DEVELOPMENT ONLY, NOT A DEPLOYMENT PATH
#
# Shells out to the Claude Code CLI on this machine instead of calling an
# inference API. It exists so you can judge identification quality and build a
# golden corpus on a subscription you already pay for, before opening a metered
# API account. Read all three of these before choosing it:
#
#  1. It costs MORE per photo than the API it stands in for. Measured on a real
#     photo -- Opus 5: $0.1802 here vs ~$0.011 direct (16x); Haiku: $0.0317 vs
#     ~$0.002 (16x). Every call re-sends the Claude Code system prompt and tool
#     definitions: ~37k cache-read plus ~12k cache-creation tokens of harness
#     that has nothing to do with your photo. It is also slower (~8s a call).
#  2. It needs the `claude` CLI installed AND interactively signed in on the
#     machine running the backend. A Docker container does not have that, and a
#     headless server only gets it if someone sits down at it.
#  3. Claude Code is a developer tool, not an inference API. Pointing an app's
#     inference at it is outside what it is for. Fine on your own laptop while
#     you are grading answers; AI_PROVIDER=anthropic is the answer for anything
#     real.
#
#   AI_PROVIDER=claude-code
#   AI_MODEL=                     # optional; empty defers to the CLI's own model
#   CLAUDE_CLI_PATH=              # optional; default: `claude` from PATH. Set the
#                                 # full path when running under a service manager
#                                 # (the CLI often lives in ~/.local/bin, which
#                                 # launchd and systemd do not inherit).
#   CLAUDE_CODE_PERMISSION_MODE=  # optional; default `default`, the most
#                                 # restrictive mode that still allows the one
#                                 # Read this needs. Escape hatch only: set
#                                 # acceptEdits if a CLI version denies the read.
#
# AI_BASE_URL and AI_API_KEY are ignored: the CLI carries its own endpoint and
# its own credentials. The backend logs costUSD per photo at info level
# so you can watch the evaluation spend as it happens.
# ---------------------------------------------------------------------------

BOX_CACHE_TTL=5m

# Subscribe to Homebox's change feed (a WebSocket on /v1/ws/events), so an edit
# made in Homebox's own UI reaches the box index within seconds instead of
# waiting out BOX_CACHE_TTL above. An index nobody has asked for within that TTL
# is marked due rather than rebuilt, so an idle backend makes no unprompted
# upstream calls. Boxwright's own writes update the cache directly and are not
# what this is for.
#
# It is a persistent outbound connection, held open with no request in flight,
# to your OWN Homebox -- the one in HOMEBOX_BASE_URL, and only that one. A
# Homebox a client named per request (ALLOW_CLIENT_HOMEBOX) is never watched.
#
# Turning it off costs latency-to-notice and nothing else: BOX_CACHE_TTL is the
# guarantee either way, and a Homebox serving no such endpoint, a reverse proxy
# that drops the Upgrade header, or a revoked key all fall back to it on their
# own. GET /healthz reports changeFeed: connected | degraded | disabled.
HOMEBOX_WATCH=true
