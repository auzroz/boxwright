# Builds Boxwright and uploads it to TestFlight, from the maintainer's Mac.
#
# Nothing here talks to a build service: the archive is made by this machine's
# Xcode and signed with this machine's Apple account (Xcode > Settings >
# Accounts). Automatic signing, so there is no certificate or profile to manage
# by hand, and none in the repository.
#
#   cd app && bundle install && (cd ios && bundle exec pod install)
#   cd ios && bundle exec fastlane beta
#
# Two credentials, each for what only it can do:
#
# - Signing: the Apple ID signed in to Xcode (Xcode > Settings > Accounts), on
#   the team below. App Store distribution uses a cloud-managed certificate,
#   which an API key may use only with the Admin role.
# - TestFlight: an App Store Connect API key (Users and Access > Integrations >
#   App Store Connect API, "App Manager" role) for the build-number lookup and
#   the upload. Keep the .p8 outside the repo and point at it, either exported
#   or in ios/fastlane/.env (gitignored; fastlane reads it itself):
#
#   ASC_KEY_ID=ABC123DEFG
#   ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
#   ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_ABC123DEFG.p8
#   APPLE_TEAM_ID=ABCDE12345          # Membership details on developer.apple.com
#
# app.boxwright must be registered as an App ID on that team (Certificates,
# Identifiers & Profiles, or the API) and have an App Store Connect record
# (My Apps > +; the API cannot create one) before the first upload.
#   DERIVED_DATA_PATH=/some/big/disk  # optional; Xcode's default otherwise
#
# The team is not in the Xcode project on purpose -- a fork must be able to
# build with its own -- so it comes from here, like the key.

default_platform(:ios)

platform :ios do
  desc "Build a release archive and upload it to TestFlight"
  lane :beta do
    api_key = asc_api_key

    # Build numbers only have to increase per marketing version. Asking App
    # Store Connect for the last one means two Macs, or a lost local counter,
    # can never upload a duplicate -- and it has to count UPLOADS, not only
    # TestFlight builds: an upload Apple rejected never becomes a build, yet
    # its number is spent. Passed as a build setting rather than written into
    # the project, so an upload never leaves the tree dirty.
    tested = latest_testflight_build_number(api_key: api_key, initial_build_number: 0)
    build_number = [tested, upload_versions(api_key).max || 0].max + 1

    signed_archive(build_number)

    upload_to_testflight(
      api_key: api_key,
      # Processing is not waited for (internal testers only for 0.1,
      # docs/RELEASE.md decision 3) -- but ingestion is, below.
      skip_waiting_for_build_processing: true,
    )
    await_ingestion(api_key, build_number)
  end

  desc "Build and sign the App Store archive without uploading it"
  lane :archive do
    # Needs no API key and no App Store Connect record, only the registered
    # App ID and the Xcode account, so it proves signing and export before an
    # upload is possible or wanted.
    signed_archive(1)
  end

  # Apple's record of every upload of this app, which -- unlike the TestFlight
  # build list -- includes the ones it refused, and says why.
  def build_uploads(api_key)
    require "net/http"
    require "json"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    uri = URI("https://api.appstoreconnect.apple.com/v1/apps/#{app.id}/buildUploads?limit=200")
    req = Net::HTTP::Get.new(uri)
    req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
    res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |h| h.request(req) }
    UI.user_error!("App Store Connect build uploads: HTTP #{res.code}") unless res.is_a?(Net::HTTPSuccess)
    JSON.parse(res.body).fetch("data", []).map { |u| u["attributes"] }
  end

  def upload_versions(api_key)
    build_uploads(api_key).map { |a| a["cfBundleVersion"].to_i }
  end

  # Waits for Apple to accept or refuse the upload, and fails the lane with
  # Apple's own words when it refuses. Without this a refusal arrives only by
  # email: the first upload of 0.1.0 "succeeded" here and was rejected minutes
  # later (ITMS-90683, a missing purpose string), invisible to the lane.
  def await_ingestion(api_key, build_number, timeout: 20 * 60)
    deadline = Time.now + timeout
    loop do
      upload = build_uploads(api_key).find { |a| a["cfBundleVersion"].to_i == build_number }
      state = upload && upload["state"]
      case state && state["state"]
      when "FAILED"
        errors = (state["errors"] || []).map { |e| "#{e["code"]}: #{e["description"]}" }
        UI.user_error!("App Store Connect refused build #{build_number}:\n#{errors.join("\n")}")
      when "COMPLETE"
        (state["warnings"] || []).each { |w| UI.important("#{w["code"]}: #{w["description"]}") }
        UI.success("Build #{build_number} accepted; TestFlight processing continues")
        return
      end
      UI.user_error!("Build #{build_number} was not accepted or refused within #{timeout / 60} minutes") if Time.now > deadline
      UI.message("Waiting for App Store Connect to check build #{build_number} (#{state ? state["state"] : "not listed yet"})")
      sleep 30
    end
  end

  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
    )
  end

  def signed_archive(build_number)
    build_app(
      workspace: "Boxwright.xcworkspace",
      scheme: "Boxwright",
      configuration: "Release",
      export_method: "app-store",
      # Automatic signing on the team given here, by the Apple ID signed in
      # to Xcode (Xcode > Settings > Accounts), NOT the API key: App Store
      # distribution uses a cloud-managed certificate, and Apple lets an API
      # key sign with one only if the key has the Admin role -- an App Manager
      # key gets "Cloud signing permission error" at export, after a full
      # archive. The account holder's Apple ID may.
      #
      # gym passes xcargs to the export as well as the archive, so
      # -allowProvisioningUpdates here covers both: Xcode creates or refreshes
      # the distribution profile for app.boxwright as it exports.
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "DEVELOPMENT_TEAM=#{ENV.fetch("APPLE_TEAM_ID").shellescape}",
        "CODE_SIGN_STYLE=Automatic",
        "-allowProvisioningUpdates",
      ].join(" "),
      export_team_id: ENV.fetch("APPLE_TEAM_ID"),
      derived_data_path: ENV["DERIVED_DATA_PATH"],
      output_directory: "build",
    )
  end
end
