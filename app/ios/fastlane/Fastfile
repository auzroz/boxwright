# Builds Boxwright and uploads it to TestFlight, from the maintainer's Mac.
#
# Nothing here talks to a build service: the archive is made by this machine's
# Xcode and signed with this machine's Apple account (Xcode > Settings >
# Accounts). Automatic signing, so there is no certificate or profile to manage
# by hand, and none in the repository.
#
#   cd app && bundle install && (cd ios && bundle exec pod install)
#   cd ios && bundle exec fastlane beta
#
# Everything authenticates with an App Store Connect API key (Users and Access >
# Integrations > App Store Connect API, "App Manager" role): the upload, the
# build-number lookup, and Xcode's own signing, so no Apple ID has to be
# signed in to Xcode. Keep the .p8 outside the repo and point at it, either
# exported or in ios/fastlane/.env (gitignored; fastlane reads it itself):
#
#   ASC_KEY_ID=ABC123DEFG
#   ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
#   ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_ABC123DEFG.p8
#   APPLE_TEAM_ID=ABCDE12345          # Membership details on developer.apple.com
#   DERIVED_DATA_PATH=/some/big/disk  # optional; Xcode's default otherwise
#
# The team is not in the Xcode project on purpose -- a fork must be able to
# build with its own -- so it comes from here, like the key.

default_platform(:ios)

platform :ios do
  desc "Build a release archive and upload it to TestFlight"
  lane :beta do
    key_path = File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path,
    )

    # The same key for xcodebuild's automatic signing, in the archive AND the
    # export: -allowProvisioningUpdates alone relies on an Apple ID signed in
    # to Xcode, and without it on the export step the distribution profile is
    # never fetched and the export fails after a full archive.
    signing = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath #{key_path.shellescape}",
      "-authenticationKeyID #{ENV.fetch("ASC_KEY_ID").shellescape}",
      "-authenticationKeyIssuerID #{ENV.fetch("ASC_ISSUER_ID").shellescape}",
    ].join(" ")

    # Build numbers only have to increase per marketing version. Asking
    # TestFlight for the last one means two Macs, or a lost local counter,
    # can never upload a duplicate. Passed as a build setting rather than
    # written into the project, so an upload never leaves the tree dirty.
    build_number = latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1

    build_app(
      workspace: "Boxwright.xcworkspace",
      scheme: "Boxwright",
      configuration: "Release",
      export_method: "app-store",
      # Xcode creates or refreshes the distribution certificate and profile
      # for app.boxwright itself (automatic signing), on the team given here.
      xcargs: [
        "CURRENT_PROJECT_VERSION=#{build_number}",
        "DEVELOPMENT_TEAM=#{ENV.fetch("APPLE_TEAM_ID").shellescape}",
        "CODE_SIGN_STYLE=Automatic",
        signing,
      ].join(" "),
      export_xcargs: signing,
      export_team_id: ENV.fetch("APPLE_TEAM_ID"),
      derived_data_path: ENV["DERIVED_DATA_PATH"],
      output_directory: "build",
    )

    upload_to_testflight(
      api_key: api_key,
      # Internal testers only for 0.1 (docs/RELEASE.md, decision 3), so
      # there is nothing to wait for.
      skip_waiting_for_build_processing: true,
    )
  end
end
